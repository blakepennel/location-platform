# =====================================================================
# location-platform — example environment. Copy to .env and edit.
#   cp .env.example .env
# .env is git-ignored. NEVER put real secrets in .env.example.
# Real Google credentials and the Timeline key are NOT set here — they live as files
# under $LOCATION_PLATFORM_HOME/secrets (see SECURITY.md), created by the auth commands.
# =====================================================================

# ---- where real data + secrets live (ALWAYS outside the git checkout) ----
# Default: ~/.location-platform
LOCATION_PLATFORM_HOME=~/.location-platform

# IANA timezone used to interpret offset-less timestamps and day/week boundaries.
# Leave unset to use the system timezone.
# LOCATION_TIMEZONE=America/New_York

# Log level: debug | info | warn | error
LOG_LEVEL=info
# Set to true ONLY for local debugging — allows precise coordinates into logs.
LOG_LOCATION_DEBUG=false

# =====================================================================
# LAYER B — OAuth used by Claude / ChatGPT to reach the MCP servers.
# (This is NOT your Google login. Google credentials never reach MCP clients.)
# =====================================================================
# The authorization server (IdP). Local dev server default:
MCP_AUTH_ISSUER=http://localhost:8700
# Optionally pin the JWKS URI (otherwise discovered from the issuer metadata).
# MCP_AUTH_JWKS_URI=

# Single-user allowlist: the OAuth subject(s) permitted to use the servers.
# With the local dev auth server this is DEV_AUTH_SUBJECT (default local-dev-user).
# With a real IdP, set this to your user id (sub) there. Comma-separated.
MCP_ALLOWED_SUBJECTS=local-dev-user
# Escape hatch (NOT recommended): accept any authenticated subject.
MCP_ALLOW_ANY_SUBJECT=false

# ---- local dev authorization server ----
DEV_AUTH_PORT=8700
DEV_AUTH_SUBJECT=local-dev-user
DEV_AUTH_ACCESS_TOKEN_TTL=600
DEV_AUTH_REFRESH_TOKEN_TTL=1209600
DEV_AUTH_ENABLE_CIMD=true

# =====================================================================
# PROJECT 2 — timeline-mcp (historical)
# =====================================================================
TIMELINE_MCP_PORT=8701
TIMELINE_MCP_PUBLIC_URL=http://localhost:8701
# Own index DB (default ~/.location-platform/timeline-mcp/timeline-index.sqlite)
# TIMELINE_MCP_DB=
# Where timeline-sync publishes exports (default ~/.location-platform/timeline)
# TIMELINE_DATA_DIR=
# Cap the maximum precision this server will ever return: semantic | approximate | exact
TIMELINE_MAX_PRECISION=exact
# Precision when a tool call doesn't ask for one: semantic (names only) | approximate | exact
TIMELINE_DEFAULT_PRECISION=semantic

# =====================================================================
# PROJECT 1 — timeline-sync (feeds timeline-mcp)
# =====================================================================
# Output dir (default ~/.location-platform/timeline). Secrets dir default
# ~/.location-platform/secrets/timeline (master token, key.b64, android_id — file-based, not here).
# TIMELINE_DATA_DIR=
# TIMELINE_SECRETS_DIR=
# Source adapter: geller (real cloud) | synthetic | local_db
TIMELINE_SOURCE=geller
# Base UTC offset (minutes) seed for timelinePath rows lacking one.
TIMELINE_DEFAULT_UTC_OFFSET_MIN=0
TIMELINE_KEEP_EXPORTS=10

# =====================================================================
# PROJECT 3 — live-location-mcp (Google Maps Location Sharing)
# =====================================================================
LIVE_MCP_PORT=8702
LIVE_MCP_PUBLIC_URL=http://localhost:8702
# Own observations DB (default ~/.location-platform/live-location/live.sqlite)
# LIVE_MCP_DB=
# Source adapter: google | synthetic
LIVE_SOURCE=google
# Netscape cookies.txt for the DEDICATED recipient Google account (file, mode 600).
# Default ~/.location-platform/secrets/live/cookies.txt
# LIVE_COOKIES_FILE=
# Stable Google person id of the sharer to track (optional if exactly one sharer).
# LIVE_SHARER_ID=
# Poll cadence (ms). Default 60000; minimum enforced 30000.
LIVE_POLL_INTERVAL=60000
LIVE_BACKOFF_MAX=900000
# Seconds after which an observation is considered stale.
LIVE_STALE_SECONDS=300
# Raw-sample retention (days). Pruning is manual-only (never automatic).
LIVE_RETENTION_DAYS=7
LIVE_MAX_PRECISION=exact
# Default precision for live history tools (where_am_i is always exact by default): approximate | exact
LIVE_DEFAULT_PRECISION=approximate

# ---- server hardening (optional) ----
# MCP_BIND_HOST=127.0.0.1
# MCP_TRUST_PROXY=false
