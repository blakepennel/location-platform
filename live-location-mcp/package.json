{
  "name": "live-location-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "live-location": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node --disable-warning=ExperimentalWarning --import tsx src/cli.ts serve",
    "daemon": "node --disable-warning=ExperimentalWarning --import tsx src/cli.ts daemon",
    "stdio": "node --disable-warning=ExperimentalWarning --import tsx src/cli.ts stdio",
    "smoke": "node --disable-warning=ExperimentalWarning --import tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@location/mcp-auth": "*",
    "@location/shared": "*",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "express": "^5.1.0",
    "zod": "^3.25.0"
  }
}
